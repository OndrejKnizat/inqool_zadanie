@startuml package-diagram
!pragma layout smetana
title Package dependencies (enforced by ArchUnit)
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
skinparam packageStyle rectangle

cloud "HTTP client" as client
package "sk.knizat.tennisclub" {
  [security]
  [controller]
  [service]
  [dao]
  [config]
  [dto]
  [mapper]
  [entity]
  [exception]
}
database "H2\n(Liquibase schema)" as db

' main vertical flow
client -down-> security : Bearer JWT /\nBasic login
security -down-> controller
controller -down-> service
service -down-> dao
dao -down-> db : EntityManager\n+ JPQL

' side dependencies
security -right-> service : UserService
config -right-> service : DataInitializer,\nAdminInitializer
controller -right-> dto
service -right-> mapper
service -right-> dto
mapper -down-> entity
dao -right-> entity
controller -left-> exception
service -left-> exception

' keep the side columns in place
config -[hidden]down- exception
dto -[hidden]down- mapper

legend bottom
  controller never references entity or dao (ArchUnit rule)
  service is the only place with @Transactional
  dao is the only place with EntityManager; every query filters deleted = false
endlegend
@enduml
